{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "typeRoots": ["./node_modules", "./node_modules/@types"],
        "types": ["bun-types"]
    },
    "include": ["index.ts", "src/**/*.ts"]
}
